{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": ["src/**", "e2e/**", "*.ts", "*.json", "!dist", "!node_modules"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "lucide-preact": {
                "importNames": [
                  "Key",
                  "KeyRound",
                  "KeySquare",
                  "KeyIcon",
                  "KeyRoundIcon",
                  "KeySquareIcon",
                  "LucideKey",
                  "LucideKeyRound",
                  "LucideKeySquare",
                  "RefreshCw",
                  "RefreshCcw",
                  "RotateCw",
                  "RotateCcw"
                ],
                "message": "站长规定：不出现钥匙图标；后台不放刷新按钮（数据由 SSE 推送）。"
              }
            }
          }
        }
      },
      "a11y": { "preset": "recommended" }
    }
  }
}
