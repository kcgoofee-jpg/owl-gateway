# Caddy 容器怎么起（新机器 / 灾难恢复；示例，线上用的是宿主机网络，具体参数以服务器上 `docker inspect caddy` 为准，这里没有核对过）：
#   docker run -d --name caddy --restart unless-stopped --network host \
#     -v /opt/caddy/Caddyfile:/etc/caddy/Caddyfile:ro -v caddy_data:/data -v caddy_config:/config caddy:2
# 网关容器固定在 Docker 网络 service-tools_edge 的 172.30.0.10:8000（见 deploy/v3/compose.yml），宿主机能直连；
# 网络只需建一次：docker network create --subnet 172.30.0.0/24 service-tools_edge。
# 网关用 FORWARDED_ALLOW_IPS 只信任 Caddy 所在网桥（172.30.0.1）带来的 X-Forwarded-For，compose 里已经配好。
# 网关不可用时的降级页（502/503/504）：只给浏览器看的页面用；出图 / 用户接口不用它（客户端要拿到真实的错误码）。
# 参数 {args[0]} = 降级响应状态码（503）。
(degraded_page) {
	header Content-Type "text/html; charset=utf-8"
	header Cache-Control "no-store"
	header Retry-After "30"
	respond `<!DOCTYPE html><html lang="zh-CN"><head><meta charset="utf-8"><title>紧急维护中 · 猫头鹰公益站</title><meta name="viewport" content="width=device-width,initial-scale=1"><style>body{font-family:system-ui,-apple-system,sans-serif;background:#0f1117;color:#e6edf3;display:flex;align-items:center;justify-content:center;min-height:100vh;margin:0;padding:20px;box-sizing:border-box}.card{background:#161b22;border:1px solid #30363d;border-radius:12px;padding:40px 36px;max-width:560px;width:100%;text-align:center;box-shadow:0 8px 24px rgba(0,0,0,0.5);box-sizing:border-box}.badge{display:inline-flex;align-items:center;gap:7px;padding:5px 12px;background:#f8514922;color:#f85149;border-radius:20px;font-size:12px;font-weight:600;margin-bottom:16px;letter-spacing:.05em}.dot{width:8px;height:8px;border-radius:50%;background:#f85149;animation:pulse 1.4s ease-in-out infinite}@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.35;transform:scale(.8)}}h1{font-size:22px;margin:0 0 14px;color:#f0883e}p{color:#8b949e;line-height:1.7;font-size:14px;margin:0 0 12px}.meta{background:#0f1117;border:1px solid #21262d;border-radius:8px;padding:12px 16px;margin:18px 0 16px;font-size:13px;color:#8b949e;display:flex;flex-direction:column;gap:6px;text-align:left}.meta b{color:#e6edf3;font-weight:600}a.l{color:#8b93f0}.fine{font-size:12px;color:#484f58;margin-top:22px}</style></head><body><div class="card"><div class="badge"><span class="dot"></span>紧急维护中</div><h1>猫头鹰公益站 · 紧急安全维护</h1><p>为了保障服务与数据安全，我们正在对服务器执行<b>紧急安全维护</b>（升级受影响的组件并进行安全加固）。维护期间出图等请求不可用，完成后本页会自动恢复访问。</p><div class="meta"><span>维护内容&nbsp;&nbsp;<b>安全加固 · 组件升级</b></span><span>预计恢复&nbsp;&nbsp;<b>数分钟至数小时内</b>（视进度更新）</span><span>开始时间&nbsp;&nbsp;<b>2026-11-06</b></span></div><p>无需操作，页面将每 30 秒自动重新检查连接。也可查看 <a class="l" href="https://status.novelai.net" target="_blank" rel="noopener">NovelAI 官方状态 ↗</a></p><p class="fine">给您带来不便，敬请谅解。</p></div><script>setTimeout(function(){ location.reload(); }, 30000);</script></body></html>` {args[0]}
}

# 网关只有一个地址 172.30.0.10（owl-gate）。部署是先停后起（cutover.sh restart），不再有临时网关 .11，
# 也不做被动健康检查：若把 .10 记成失败，新网关起来后还会被当成故障最多 10 秒，白白拉长停机。
(gate_lb) {
	# 同一台机器上的容器，连接正常不到 1 毫秒。连不上又不回拒绝（.10 刚被删、新容器还没起来的那一两秒）时，
	# 默认要等 3 秒才转到降级页，客户端多半先放弃了；1 秒就够判断
	transport http {
		dial_timeout 1s
	}
}

gate.davidzhao.top {
	# 桥接接口只在容器内网使用：整段屏蔽（OAuth 领取回调已删除）；以后新增的桥接路由默认不暴露。
	@bridge {
		path /self-register /self-register/*
	}
	respond @bridge 404

	# 【安全红线】边缘剥离外部伪造的内部测试头，严防绕过防分享与风控
	request_header -X-Admin-Test
	request_header -X-Test-Channel

	# 只压缩网页、后台、前端资源和公开 JSON；出图接口与两条实时推送（SSE）不压缩，避免缓冲
	@compress {
		path / /admin /admin/* /public/* /_owl/*
		not path /public/live/stream /admin/api/events
	}
	encode @compress zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# 页面降级：网关容器重启或 502/503/504 时，2 秒内快速降级到静态页，避免同生共死报原始 502。
	# 只管浏览器打开的页面；出图 / 用户接口（/ai /user /v1 …）仍走下面那条（最长等 150 秒让重启中的网关接上，客户端拿真实错误码）。
	@pages {
		method GET HEAD
		path /
	}
	handle @pages {
		reverse_proxy 172.30.0.10:8000 {
			import gate_lb
			lb_try_duration 2s
			lb_try_interval 500ms
			@page_err status 502 503 504
			handle_response @page_err {
				import degraded_page 503
			}
		}
	}

	# 连不上网关（容器重启 / 停机，Caddy 自己报 502）时，上面的 handle_response 不会触发——它只处理「上游回了 502/503/504」。
	# 这里接住 Caddy 自己的错误：只对浏览器打开的页面换成降级页；出图 / 用户接口仍返回真实的错误。
	handle_errors {
		@page_down {
			expression {http.error.status_code} in [502, 503, 504]
			method GET HEAD
			path /
		}
		handle @page_down {
			import degraded_page 503
		}
	}

	# 直连容器固定 IP（不走 127.0.0.1:3003 的 docker-proxy）
	reverse_proxy 172.30.0.10:8000 {
		import gate_lb
		lb_try_duration 150s
		lb_try_interval 500ms
	}
}
