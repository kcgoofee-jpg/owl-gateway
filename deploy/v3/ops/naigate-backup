#!/bin/bash
# 每晚 03:30（/etc/cron.d/naigate-backup）。GFS 轮换：每日留 14 份、每周日留 8 份、每月 1 号留 6 份。
set -euo pipefail
# 轮换那几行：目录里一份都没有时 ls 返回 2，在 pipefail 下会把整个备份判成失败，所以兜成 true
R=/opt/backups
mkdir -p "$R/daily" "$R/weekly" "$R/monthly"
OUT="$R/daily/nai_gate-$(date +%F).db.gz"
/usr/local/bin/naigate-snapshot "$OUT"
# 备份里不留生成记录（提示词 / 参数 / 图片指纹）：线上 30 天后就删了，备份要留到 6 个月，
# 不清掉等于把提示词的保存期偷偷拉长（站长 10-18）。清完做完整性检查，不通过就保留原快照并报错退出。
/usr/local/bin/naigate-strip-prompts "$OUT"
[ "$(date +%u)" = 7 ] && cp -p "$OUT" "$R/weekly/"
[ "$(date +%d)" = 01 ] && cp -p "$OUT" "$R/monthly/"
{ ls -1t "$R"/daily/nai_gate-*.db.gz 2>/dev/null || true; } | tail -n +15 | xargs -r rm -f
{ ls -1t "$R"/weekly/nai_gate-*.db.gz 2>/dev/null || true; } | tail -n +9  | xargs -r rm -f
{ ls -1t "$R"/monthly/nai_gate-*.db.gz 2>/dev/null || true; } | tail -n +7  | xargs -r rm -f
