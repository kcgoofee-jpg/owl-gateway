#!/bin/bash
# 每晚 03:30（/etc/cron.d/naigate-backup）。本地快速回滚层：daily 3 份、weekly 2 份、monthly 2 份。
# 历史/异地备份在 S3（opt/owl/ops/nightly_backup.sh 04:30 加密推送，生命周期 60 天），本地不再堆 14+8+6。
set -euo pipefail
umask 077
# 轮换那几行：目录里一份都没有时 ls 返回 2，在 pipefail 下会把整个备份判成失败，所以兜成 true
R=/opt/backups
install -d -m 700 "$R/daily" "$R/weekly" "$R/monthly"
OUT="$R/daily/nai_gate-$(date +%F).db.gz"
/usr/local/bin/naigate-snapshot "$OUT"
[ "$(date +%u)" = 7 ] && cp -p "$OUT" "$R/weekly/"
[ "$(date +%d)" = 01 ] && cp -p "$OUT" "$R/monthly/"
{ ls -1t "$R"/daily/nai_gate-*.db.gz 2>/dev/null || true; } | tail -n +4 | xargs -r rm -f
{ ls -1t "$R"/weekly/nai_gate-*.db.gz 2>/dev/null || true; } | tail -n +3  | xargs -r rm -f
{ ls -1t "$R"/monthly/nai_gate-*.db.gz 2>/dev/null || true; } | tail -n +3  | xargs -r rm -f
