[Unit]
Description=猫头鹰公益站巡检（nai-ops patrol：只读体检，只有「危险」才私信站长）
Documentation=https://github.com/kcgoofee-jpg/owl-gateway/blob/main/deploy/ops/README.md
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/service-tools
# 退出码 0 正常 / 1 注意 / 2 危险：都算「执行成功」；3 = 巡检自身出错，算失败
ExecStart=/opt/owl/nai-ops patrol --oneline --alert
SuccessExitStatus=0 1 2
SyslogIdentifier=nai-patrol
