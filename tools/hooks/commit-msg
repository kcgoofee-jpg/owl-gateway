#!/usr/bin/env bash
# The repo is public: commit messages are English, technical, and carry no operational data.
# Rejects CJK text, IPv4 addresses, 17-20 digit IDs (Discord snowflakes) and member key refs (K123).
# Enable once per clone: git config core.hooksPath tools/hooks
set -euo pipefail
msg=$(grep -v '^#' "$1")
fail() { printf 'commit-msg: %s\n' "$*" >&2; exit 1; }

perl -CS -ne 'exit 1 if /\p{Han}|\p{Hiragana}|\p{Katakana}|[\x{3000}-\x{303F}\x{FF01}-\x{FF60}]/' <<<"$msg" \
  || fail "write the message in English (CJK characters found)"
grep -qE '\b[0-9]{1,3}(\.[0-9]{1,3}){3}\b' <<<"$msg" && fail "no IP addresses in commit messages"
grep -qE '\b[0-9]{17,20}\b' <<<"$msg" && fail "no Discord IDs (17-20 digit numbers) in commit messages"
grep -qE '\bK[0-9]{2,4}\b' <<<"$msg" && fail "no member key numbers (K123) in commit messages"
exit 0
