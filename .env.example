# ===== 猫头鹰公益站（NAI Gate 3.0）配置 =====
# 复制为 .env 后修改。所有变量均有默认值，只有前三项是必须设置的。
#
# 环境变量只放密钥和基础设施（地址、ID、网络、数据目录）。额度、名额、有效期、记录开关、限速这类运行时参数
# 不在这里：它们是后台可改的设置（没设过时用代码里的默认值），或者是代码常量。线上 .env 里多出来的旧变量
# （DEFAULT_*、REGISTER_*、AUDIT_*、QUEUE_TIMEOUT、TZ ……）程序不再读，可以删掉。

# 【必填】管理后台密码（/admin 登录用），务必改成强密码
ADMIN_PASSWORD=changeme-please

# 后台 Cookie 默认要求 HTTPS；HTTP 访问设为 0，重新创建容器生效。
# ADMIN_COOKIE_SECURE=1

# 【必填】NovelAI 持久 API Token（可多个，英文逗号分隔组成令牌池；只有一把也用这个名字）
# 获取：novelai.net → 用户设置(User Settings) → Account → Get Persistent API Token
# 强烈建议使用公益站专用小号的 Token，不要用主号！
# 在后台「上游令牌池」增删改过 Token 之后，令牌池以 data/upstream_tokens.json 为准，这一项不再读。
NAI_TOKENS=pst-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：按 NAI_TOKENS 的顺序设置每把 Token 能不能花 Anlas（1=允许、0=禁止，缺省允许）。
# 只在没有 upstream_tokens.json 时生效；接管后以文件里每把 Token 的 allow_anlas 为准。
# V5 日限额、启停、出图并发都在后台「总览 → 上游令牌池」按 Token 设（原 NAI_TOKEN_V5_DAILY_LIMITS 已删除）。
# NAI_TOKEN_ALLOW_ANLAS=1,0

# Cookie/会话签名密钥（留空则首次启动自动生成并保存在 data/secret_key）
# SECRET_KEY=

# 数据目录（SQLite 数据库、密钥文件）
# DATA_DIR=data

# ---- Key 自动回收 ----
# 连续这么多天没有成功生成过图片（从未生成过则按领取时间算）会删除 Key（不拉黑，之后可以再 /register 领新的）；邀请 Key 不受影响；0=关闭。
# KEY_INACTIVITY_DELETE_DAYS=3

# ---- 图片安全钳制（写死在代码里，没有环境变量）----
# 作用于未开通 Anlas 的普通 Key：单张 / ≤28 步 / 关闭 SMEA；V4.5 按像素面积 ≤1024x1024，V5 按 Normal 预设边界。
# img2img / 局部重绘只看每把 Key 的「允许图生图」（后台改 Key），且该 Key 要有 Anlas 权限。

# ---- 后台里改的东西（不是环境变量）----
# 「额度与保护」页：账号保护（每日 / 每小时上限、自动调整范围）、排队与冷却、Anlas 与 V5 预算（含 Vibe 每日 Anlas 池）、动态额度。
# 「领 Key」页：开放与否、名额、新成员默认额度 / 有效期 / 功能、限定身份组、生成记录开关（提示词 / 原图 / 保留天数）。
# 新建 Key 的默认值也读「领 Key」页的设置，不另设环境变量。

# 跨域来源：英文逗号分隔；默认 *，空值关闭跨域中间件，不允许跨域 Cookie
# CORS_ORIGINS=*

# 上游地址（一般不用改）
# NAI_IMAGE_HOST=https://image.novelai.net

# ---- 上游防封与网络拟真 (Anti-Ban) ----
# 上游网络代理（支持 http://, https://, socks5://；让出站流量走海外原生住宅或独立干净出口 IP）
# UPSTREAM_PROXY=
# 浏览器指纹不可配置：每把 Token 按序号固定一个 Chrome（149 Windows / 148 Windows / 149 macOS），
# UA、Sec-CH-UA*、请求头顺序与 TLS / HTTP2 都出自同一个 profile，HTTP/2 由 ALPN 协商。
# （UPSTREAM_USER_AGENT、UPSTREAM_HTTP2 已删除：单独改 UA 会与 TLS 指纹对不上。）
# 出图后静默（原 POST_REQUEST_JITTER_MIN/MAX）已移到后台「额度与保护」：guard_post_jitter_min / _max，默认 1～3 秒。
# 每把 Token 同时出几张图只在后台「上游令牌池」设（1～4，默认 1；原 SINGLE_IMAGE_SLOT_ENFORCED 已删除）。

# ---- Discord 自助领取 Key（可选；以下全部配置才会启用）----
# 用户在指定服务器输入 /register → 机器人调 /self-register/issue → Key 只在本人可见的回复里发（不走 OAuth、不私信）。
# 在 https://discord.com/developers/applications 创建应用；若要开放网页「用 Discord 登录」，OAuth2 Redirects 添加：<SITE_URL>/login/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_BOT_TOKEN=
# REGISTRATION_BRIDGE_SECRET=      # 随机长字符串（≥32 个字符），机器人与网关共用
# DISCORD_GUILD_ID=                # 发 /register 的服务器 ID
# SITE_URL=https://gate.example.com
# DISCORD_INVITE_URL=              # 可选：落地页上的「加入 Discord」按钮链接
# DISCORD_MEMBER_ROLE_ID=          # 可选：领到 Key 自动挂上此身份组，Key 到期/撤销自动摘除（机器人需「管理身份组」，且其角色排在 King 之下、该身份组之上）
# 名额、新成员默认额度 / 有效期 / 功能、「只有某个身份组的人能领」都在后台「领 Key」页设置，没有环境变量。

# ---- 告警（可选）：重大事故时机器人私信站长（网关和宿主机巡检都读这一个）----
# ALERT_USER_ID = 你的 Discord 用户 ID（需 DISCORD_BOT_TOKEN，且机器人已加入你们共同的服务器）。
# ALERT_USER_ID=
# USAGE_LOG_RETENTION_DAYS=0        # 用量明细日志保留天数；0=不删（线上就是 0）。每日计数器和账本不受影响

# ---- 网关进程（3.0）----
# BIND=0.0.0.0:8000                 # 监听地址（容器内）；健康检查用 PORT（默认 8000）
# STATIC_DIR=                       # 指向磁盘上的前端产物目录可热修前端；默认用编进二进制的版本
# FORWARDED_ALLOW_IPS=127.0.0.1     # 只信任这些直连对端带来的 X-Forwarded-For（Caddy 在 Docker 网桥上时加 172.30.0.1）
# ADMIN_ALLOWED_ORIGINS=            # 后台写接口额外允许的 Origin（逗号分隔；默认只认本站 Host）
# DISCORD_API_BASE=https://discord.com/api/v10   # 测试时指向本地假服务
# RUST_LOG=info                     # 日志级别
# 时区固定 Asia/Shanghai、服务日 07:00 重置，都是代码常量，不读 TZ / DAY_RESET_HOUR（容器里设 TZ 只影响日志时间）。

# ---- 宿主机巡检（/opt/owl/nai-ops patrol，systemd 定时）----
# NAI_GATE_CONTAINERS=owl-gate,owl-naimei,caddy   # 要检查的容器（第一个是网关）
# PATROL_COOLDOWN=21600             # 同样的问题多久再提醒一次（秒）
